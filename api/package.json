{
  "name": "marlix-api",
  "version": "0.1.0",
  "description": "marlix backend: the only component that talks to the LLM and the database.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "llm:smoke": "tsx scripts/llm-smoke.ts",
    "crisis:eval": "tsx scripts/crisis-classifier-eval.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "jose": "^6.2.12",
    "openai": "^7.32.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
