# Copy this file to .env and fill in the values. Never commit .env.
# The server validates these variables at startup: if a required one is
# missing or invalid, it does not start and prints which one.

# Server
# Port the API listens on. Optional; defaults to 3000.
PORT=3000

# LLM
# Provider that answers the chat. Optional; defaults to groq (the only one for now).
LLM_PROVIDER=groq
# Optional; defaults to 15000. Milliseconds to wait for one LLM call before it
# fails. Network errors, 5xx and timeouts are retried once.
LLM_TIMEOUT_MS=15000

# Groq (LLM_PROVIDER=groq)
# Required. Create the key at https://console.groq.com/keys
GROQ_API_KEY=
# Required. Model used for the conversation. Groq retires models: change it here, not in code.
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Groq's OpenAI-compatible endpoint; only change it for tests.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional; defaults to low. Reasoning effort for gpt-oss models: low, medium,
# high, or none for models that do not reason.
GROQ_REASONING_EFFORT=low
