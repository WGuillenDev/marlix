# Copy this file to .env and fill in the values. Never commit .env.

# Server
# Port the API listens on. Optional; defaults to 3000.
PORT=3000

# Groq (LLM). Create the key at https://console.groq.com/keys
GROQ_API_KEY=
# Model used for the conversation. Groq retires models: change it here, not in code.
GROQ_MODEL=openai/gpt-oss-120b
