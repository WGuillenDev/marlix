# Copy this file to .env and fill in the values. Never commit .env.
# The server validates these variables at startup: if a required one is
# missing or invalid, it does not start and prints which one.

# Server
# Port the API listens on. Optional; defaults to 3000.
PORT=3000

# LLM
# Provider that answers the chat. Optional; defaults to groq (the only one for now).
LLM_PROVIDER=groq
# Optional; defaults to 15000. Milliseconds to wait for one LLM call before it
# fails. Network errors, 5xx and timeouts are retried once.
LLM_TIMEOUT_MS=15000

# Groq (LLM_PROVIDER=groq)
# Required. Create the key at https://console.groq.com/keys
GROQ_API_KEY=
# Required. Model used for the conversation. Groq retires models: change it here, not in code.
GROQ_MODEL=openai/gpt-oss-120b
# Optional. Groq's OpenAI-compatible endpoint; only change it for tests.
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Optional; defaults to low. Reasoning effort for gpt-oss models: low, medium,
# high, or none for models that do not reason.
GROQ_REASONING_EFFORT=low

# Crisis classifier (second layer of the crisis filter, docs/crisis-protocol.md)
# Optional; defaults to openai/gpt-oss-20b. A different model than the chat,
# so it has its own quota.
CRISIS_CLASSIFIER_MODEL=openai/gpt-oss-20b
# Optional; defaults to 5000. A timeout counts as a crisis.
CRISIS_CLASSIFIER_TIMEOUT_MS=5000

# Chat context (S4-5)
# Optional; defaults to 16. How many of the last messages of the conversation
# the model sees with each new one (2 to 40). Lower it if Groq's free quota
# runs out.
CHAT_CONTEXT_MESSAGES=16

# Supabase (S4-1)
# Required. The project URL from Project Settings → Data API, only the base
# (https://<project-ref>.supabase.co), without /rest/v1. Session tokens on /v1
# are checked against this project's public signing keys (S4-3).
SUPABASE_URL=
# Required. Project Settings → API Keys → Secret keys; starts with sb_secret_.
# It bypasses RLS: only the backend holds it, never the app, a commit or a chat.
SUPABASE_SECRET_KEY=
