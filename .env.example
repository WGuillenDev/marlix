# Local database (docker-compose.yml). Copy this file to .env and set your own
# values. They are only used on your computer; never commit .env.

# Password of the `postgres` user of the local database.
POSTGRES_PASSWORD=
# Host port for the database (pgAdmin and the backend connect here).
DB_PORT=54322

# pgAdmin login (any email-like value works; it is local only).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
# Host port for pgAdmin: http://localhost:5050
PGADMIN_PORT=5050
